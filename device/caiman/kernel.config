# SPDX-License-Identifier: MIT
# caiman's kernel options, merged by bin/omamobile kernel on top of
# kernel/configs/omamobile.config.

# The zuma watchdog driver stops ABL's cluster watchdogs, so build the soft
# and buddy hard-lockup detectors that zumapro-caiman.dts's bootargs turn
# into panics (panic=10).
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
