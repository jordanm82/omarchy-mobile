#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-device-caiman. reboot-to is compiled from
# src/reboot-to.c in this directory, so a copied package still builds.
# Do not execute reboot-to.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

for script in build install bin/* test/*; do
  bash -n "$script" || fail "$script parses"
done
sh -n uwsm/env.d/omamobile-caiman-graphics || fail "uwsm env.d parses as POSIX shell"
pass "scripts parse"

grep -q '\.\./\.\.' build install && fail "build or install reaches outside the package directory"
pass "build and install stay inside the package directory"

if [[ -f ../omamobile-device-cheetah/src/reboot-to.c ]]; then
  cmp -s src/reboot-to.c ../omamobile-device-cheetah/src/reboot-to.c \
    || fail "reboot-to.c drifted from the cheetah package"
  pass "reboot-to.c matches the cheetah source"
  cmp -s vendor/udev/rules.d/10-omamobile-storage.rules \
    ../omamobile-device-cheetah/vendor/udev/rules.d/10-omamobile-storage.rules \
    || fail "the storage rule drifted from the cheetah package"
  pass "the storage rule matches the cheetah package"
  cmp -s etc/omamobile-mirrorlist ../omamobile-device-cheetah/etc/omamobile-mirrorlist \
    || fail "the mirrorlist drifted from the cheetah package"
  pass "the mirrorlist matches the cheetah package"
  cmp -s <(sed -n '/^# --- the \[omamobile\] channel/,$p' omamobile-device-caiman.install) \
    <(sed -n '/^# --- the \[omamobile\] channel/,$p' ../omamobile-device-cheetah/omamobile-device-cheetah.install) \
    || fail "the install script's channel handling drifted from the cheetah package"
  pass "the install script keeps the [omamobile] channel as the cheetah package does"
  cmp -s vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
    ../omamobile-device-cheetah/vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
    || fail "the power-key drop-in drifted from the cheetah package"
  pass "the power-key drop-in matches the cheetah package"
  cmp -s omamobile-device-caiman.install \
    ../omamobile-device-cheetah/omamobile-device-cheetah.install \
    || fail "the pacman install script drifted from the cheetah package"
  pass "the pacman install script matches the cheetah package"
  sleep=vendor/systemd/sleep.conf.d/10-omamobile.conf
  [[ $(grep -v '^#' "$sleep") == "$(grep -v '^#' "../omamobile-device-cheetah/$sleep")" ]] \
    || fail "the sleep drop-in's settings drifted from the cheetah package"
  pass "the sleep drop-in's settings match the cheetah package"
fi
if [[ -f ../omamobile-device-husky/vendor/systemd/network/20-usb-gadget.network ]]; then
  cmp -s vendor/systemd/network/20-usb-gadget.network \
    ../omamobile-device-husky/vendor/systemd/network/20-usb-gadget.network \
    || fail "the USB gadget network drifted from the husky package"
  cmp -s vendor/NetworkManager/conf.d/10-omamobile-usb.conf \
    ../omamobile-device-husky/vendor/NetworkManager/conf.d/10-omamobile-usb.conf \
    || fail "the NetworkManager drop-in drifted from the husky package"
  pass "the USB link's network files match the husky package"
fi
grep -q 'omamobile-keyring' PKGBUILD || fail "pacman needs omamobile-keyring"
grep -q 'kmod' PKGBUILD || fail "pacman needs kmod for graphics-start"
grep -q '^install=omamobile-device-caiman.install$' PKGBUILD \
  || fail "the pacman install script is not named"
[[ -f etc/omamobile-mirrorlist && -f omamobile-device-caiman.install ]] \
  || fail "the pacman mirrorlist or install script is missing"
pass "pacman gets the keyring, kmod, the mirrorlist, and the install script"
if [[ -f ../../device/caiman/device.conf ]]; then
  cmp -s device.conf ../../device/caiman/device.conf \
    || fail "device.conf drifted from the descriptor"
  pass "device.conf matches the descriptor"
fi

./build "$tmp/build" || fail "reboot-to compiles"
[[ -x $tmp/build/reboot-to ]] || fail "reboot-to is not executable"
pass "reboot-to compiles"

./install "$tmp/root" "$tmp/build"
for f in usr/bin/reboot-to \
         usr/bin/omamobile-bt-addr \
         usr/bin/omamobile-caiman-aoc-start \
         usr/bin/omamobile-caiman-charge-limit \
         usr/bin/omamobile-caiman-graphics-start \
         usr/lib/modprobe.d/omamobile-caiman-aoc.conf \
         usr/lib/modprobe.d/omamobile-caiman-clk-acpm.conf \
         usr/lib/modprobe.d/omamobile-caiman-display.conf \
         usr/lib/modprobe.d/omamobile-caiman-guards.conf \
         usr/lib/udev/rules.d/10-omamobile-storage.rules \
         usr/lib/udev/rules.d/20-omamobile-torch.rules \
         usr/lib/udev/rules.d/72-omamobile-feedbackd.rules \
         usr/lib/udev/rules.d/75-omamobile-caiman-charger.rules \
         usr/lib/udev/rules.d/80-omamobile-bt-addr.rules \
         usr/lib/systemd/network/20-usb-gadget.network \
         usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf \
         usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf \
         usr/lib/systemd/sleep.conf.d/10-omamobile.conf \
         usr/lib/systemd/system/linux-modules-cleanup.service.d/10-omamobile-caiman.conf \
         usr/lib/systemd/system/display-manager.service.d/10-omamobile-caiman.conf \
         usr/lib/systemd/system/omamobile-bt-addr@.service \
         usr/lib/systemd/system/omamobile-caiman-aoc.service \
         usr/lib/systemd/system/omamobile-caiman-graphics.service \
         usr/share/uwsm/env.d/omamobile-caiman-graphics \
         usr/share/omamobile/device.conf \
         usr/share/omamobile/device-caiman/version \
         usr/share/licenses/omamobile-device-caiman/LICENSE \
         etc/pacman.d/omamobile-mirrorlist; do
  [[ -f $tmp/root/$f ]] || fail "install stages $f"
done
for b in usr/bin/reboot-to usr/bin/omamobile-bt-addr \
         usr/bin/omamobile-caiman-aoc-start \
         usr/bin/omamobile-caiman-charge-limit usr/bin/omamobile-caiman-graphics-start; do
  [[ -x $tmp/root/$b ]] || fail "$b must be installed executable"
done
[[ ! -x $tmp/root/usr/lib/modprobe.d/omamobile-caiman-guards.conf \
   && ! -x $tmp/root/usr/lib/modprobe.d/omamobile-caiman-aoc.conf \
   && ! -x $tmp/root/usr/lib/systemd/system/omamobile-caiman-aoc.service \
   && ! -x $tmp/root/usr/lib/systemd/system/omamobile-caiman-graphics.service \
   && ! -x $tmp/root/usr/lib/udev/rules.d/75-omamobile-caiman-charger.rules ]] \
  || fail "non-script vendor files must not be executable"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-caiman-graphics.service") == ../omamobile-caiman-graphics.service ]] \
  || fail "omamobile-caiman-graphics.service is enabled by a vendor wants link"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-caiman-aoc.service") == ../omamobile-caiman-aoc.service ]] \
  || fail "omamobile-caiman-aoc.service is enabled by a vendor wants link"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-speaker-protection.service") == /usr/lib/systemd/system/omamobile-speaker-protection.service ]] \
  || fail "omamobile-speaker-protection.service is enabled by a vendor wants link"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/omamobile-aoc.service") == omamobile-caiman-aoc.service ]] \
  || fail "omamobile-aoc.service must alias omamobile-caiman-aoc.service"
[[ $(find "$tmp/root" -type f -o -type l | wc -l) -eq 32 ]] \
  || fail "install stages expected 32 paths: $(cd "$tmp/root" && find . -type f -o -type l | sort | tr '\n' ' ')"
grep -qx 'ConditionPathExists=!/usr/share/omamobile/device-caiman/version' \
  "$tmp/root/usr/lib/systemd/system/linux-modules-cleanup.service.d/10-omamobile-caiman.conf" \
  || fail "module cleanup guard missing"
for mod in panthor gs_decon cs40l26_vibra leds_lm3644 max77779_battery phy_zuma_pcie pcie_gs201 brcmfmac hci_uart nxp_nci_i2c; do
  grep -qx "blacklist $mod" "$tmp/root/usr/lib/modprobe.d/omamobile-caiman-guards.conf" \
    || fail "$mod must be blacklisted for autoload"
done
for mod in trusty_core trusty_log trusty_ipc trusty_virtio gsa gs201_aoc_sysmmu mailbox_wc aoc_core aoc_channel_dev aoc_char_dev aoc_alsa_dev aoc_alsa_dev_util snd_soc_cs35l41_spi; do
  grep -qx "blacklist $mod" "$tmp/root/usr/lib/modprobe.d/omamobile-caiman-aoc.conf" \
    || fail "$mod must be blacklisted in omamobile-caiman-aoc.conf"
done
grep -qx 'options gs_decon max_refresh=120 screen_off=2' \
  "$tmp/root/usr/lib/modprobe.d/omamobile-caiman-display.conf" \
  || fail "gs_decon display options missing"
grep -qx 'options clk_acpm zumapro_gpu_max_khz=890000' \
  "$tmp/root/usr/lib/modprobe.d/omamobile-caiman-clk-acpm.conf" \
  || fail "clk_acpm max GPU clock missing"
grep -qx 'MemorySleepMode=s2idle' "$tmp/root/usr/lib/systemd/sleep.conf.d/10-omamobile.conf" \
  || fail "suspend must use s2idle"
grep -qx 'AllowHibernation=no' "$tmp/root/usr/lib/systemd/sleep.conf.d/10-omamobile.conf" \
  || fail "there is no swap to hibernate to"
grep -q 'KERNEL=="sda", MODE="0000"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "the whole-disk node is made inaccessible"
grep -q 'ID_PART_ENTRY_NAME}!="userdata"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "userdata is the only partition desktop tools may see"
grep -q 'SUBSYSTEM=="power_supply", KERNEL=="max77779-charger",.*omamobile-caiman-charge-limit' \
  "$tmp/root/usr/lib/udev/rules.d/75-omamobile-caiman-charger.rules" \
  || fail "charger udev rule missing"
grep -q 'SUBSYSTEM=="bluetooth", KERNEL=="hci\[0-9\]\*",.*omamobile-bt-addr' \
  "$tmp/root/usr/lib/udev/rules.d/80-omamobile-bt-addr.rules" \
  || fail "bluetooth address udev rule missing"
grep -q 'Address=172.16.42.1/24' "$tmp/root/usr/lib/systemd/network/20-usb-gadget.network" \
  || fail "usb0 keeps the initramfs address"
power="$tmp/root/usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf"
grep -qx '\[Login\]' "$power" \
  || fail "the power-key drop-in needs a [Login] header"
grep -q '^HandlePowerKey=ignore$' "$power" \
  || fail "a short press must not power the phone off"
grep -q '^HandlePowerKeyLongPress=ignore$' "$power" \
  || fail "the long press stays the PMIC reset"
grep -q '^PACKAGE=omamobile-device-caiman$' "$tmp/root/usr/share/omamobile/device.conf" \
  || fail "the installed descriptor is caiman"
for absent in usr/bin/omamobile-boot-success usr/bin/omamobile-bootctl \
              usr/lib/systemd/system/omamobile-boot-success.service \
              usr/bin/omamobile-wifi-start usr/bin/omamobile-charge-guard \
              usr/bin/omamobile-camera-start; do
  [[ ! -e $tmp/root/$absent ]] || fail "install includes $absent"
done
pass "install stages expected package files, modes, and guards without slot marking, radio, or camera"

# Exercise graphics-start in a scratch root: marker block, --retry recovery,
# panthor + gs_decon bind, allow_tx gating, card preference, and failure/skip cases.
fake=$tmp/fake
fbin=$tmp/fbin
tlog=$tmp/calls
dt="$fake/proc/device-tree/soc"
mkdir -p "$fake/sys/bus/platform/devices/1f000000.gpu" \
         "$fake/sys/bus/platform/devices/19470000.display-controller" \
         "$fake/sys/bus/platform/drivers/panthor" \
         "$fake/sys/bus/platform/drivers/gs-decon" \
         "$dt/usi@10c900c0/i2c@10c90000/haptic-driver@43" \
         "$dt/soc-unused" \
         "$dt/usi@108b00c0/i2c@108b0000/led-controller@63" \
         "$dt/usi@108d00c0/i2c@108d0000/fuel-gauge@36" \
         "$dt/usi@155d00c0/serial@155d0000/bluetooth" \
         "$dt/usi@10c900c0/i2c@10c90000/nfc@8" \
         "$fake/dev/dri/by-path" "$fake/proc" "$fbin"
rm -rf "$dt/soc-unused"
: > "$fake/dev/dri/card0"
ln -s ../card0 "$fake/dev/dri/by-path/platform-chosen:framebuffer-card"
cat > "$fbin/modprobe" <<EOF
#!/bin/bash
set -euo pipefail
[[ \${FAIL_MODULE:-} != "\$1" ]] || { echo "\$*" >> "$tlog"; exit 1; }
case \$1 in
  panthor) ln -sfn "$fake/sys/bus/platform/drivers/panthor" "$fake/sys/bus/platform/devices/1f000000.gpu/driver" ;;
  gs_dsim_cmd) p="$fake/sys/module/gs_dsim_cmd/parameters"; [[ -e \$p/allow_tx ]] || { mkdir -p "\$p"; echo 0 > "\$p/allow_tx"; } ;;
  gs_decon)
    : > "$fake/dev/dri/card1"
    ln -sfn ../card1 "$fake/dev/dri/by-path/platform-19470000.display-controller-card"
    ln -sfn "$fake/sys/bus/platform/drivers/gs-decon" "$fake/sys/bus/platform/devices/19470000.display-controller/driver"
    set -- "\$@" "allow_tx=\$(cat "$fake/sys/module/gs_dsim_cmd/parameters/allow_tx" 2>/dev/null || echo none)" ;;
  leds_lm3644)
    mkdir -p "$fake/sys/class/leds/white:torch"
    echo "\${TORCH_INIT_BRIGHTNESS:-0}" > "$fake/sys/class/leds/white:torch/brightness" ;;
  max77779_battery)
    mkdir -p "$fake/sys/class/power_supply/max77779-battery"
    echo 87 > "$fake/sys/class/power_supply/max77779-battery/capacity" ;;
  pcie_gs201)
    mkdir -p "$fake/sys/bus/pci/devices/0000:01:00.0" ;;
  brcmfmac)
    mkdir -p "$fake/sys/class/net/wlp1s0" ;;
  nxp_nci_i2c)
    [[ \${NO_NFC_DEV:-0} == 1 ]] || mkdir -p "$fake/sys/class/nfc/nfc0" ;;
esac
echo "\$*" >> "$tlog"
EOF
printf '#!/bin/bash\necho synced >> "%s"\n' "$tlog" > "$fbin/sync"
printf '#!/bin/bash\nexit 0\n' > "$fbin/sleep"
chmod +x "$fbin/"*

periph_dt_disable() {
  for n in "$dt/usi@10c900c0/i2c@10c90000/haptic-driver@43" \
           "$dt/usi@108b00c0/i2c@108b0000/led-controller@63" \
           "$dt/usi@108d00c0/i2c@108d0000/fuel-gauge@36" \
           "$dt/usi@155d00c0/serial@155d0000/bluetooth" \
           "$dt/usi@10c900c0/i2c@10c90000/nfc@8"; do
    printf 'disabled\0' > "$n/status"
  done
  rm -f "$dt/usi@10c900c0/i2c@10c90000/nfc@8/clocks"
  rm -rf "$fake/sys/bus/platform/devices/13120000.pcie" \
         "$fake/proc/device-tree/reserved-memory/wifi-dma-pool" \
         "$fake/usr/lib/firmware"
}
periph_dt_enable() {
  for n in "$dt/usi@10c900c0/i2c@10c90000/haptic-driver@43" \
           "$dt/usi@108b00c0/i2c@108b0000/led-controller@63" \
           "$dt/usi@108d00c0/i2c@108d0000/fuel-gauge@36" \
           "$dt/usi@155d00c0/serial@155d0000/bluetooth" \
           "$dt/usi@10c900c0/i2c@10c90000/nfc@8"; do
    printf 'okay\0' > "$n/status"
  done
  : > "$dt/usi@10c900c0/i2c@10c90000/nfc@8/clocks"
  mkdir -p "$fake/sys/bus/platform/devices/13120000.pcie" \
           "$fake/proc/device-tree/reserved-memory/wifi-dma-pool" \
           "$fake/usr/lib/firmware/updates/brcm"
  : > "$fake/usr/lib/firmware/updates/brcm/brcmfmac4390b1-pcie.google,zumapro-caiman.bin"
}

reset_gfx() {
  : > "$tlog"
  rm -rf "$fake/var/lib/omamobile/caiman-graphics-started" \
         "$fake/sys/bus/platform/devices/1f000000.gpu/driver" \
         "$fake/sys/bus/platform/devices/19470000.display-controller/driver" \
         "$fake/sys/bus/pci/devices/0000:01:00.0" \
         "$fake/sys/module" "$fake/run" "$fake/dev/dri/card1" \
         "$fake/dev/dri/by-path/platform-19470000.display-controller-card" \
         "$fake/sys/class/leds" "$fake/sys/class/power_supply" "$fake/sys/class/net" "$fake/sys/class/nfc"
  periph_dt_disable
  echo "console=null ${1:+exynos_drm.panel_name=$1 }mem_sleep_default=s2idle" > "$fake/proc/cmdline"
}
loads() { grep -v '^synced$' "$tlog" | cut -d' ' -f1 | tr '\n' ' ' | sed 's/ $//'; }

# 1. Existing marker blocks GPU, display, and peripherals until --retry, while still publishing simpledrm.
reset_gfx google-cm4
periph_dt_enable
mkdir -p "$fake/var/lib/omamobile"
echo "2026-11-13 gpu" > "$fake/var/lib/omamobile/caiman-graphics-started"
PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start" >/dev/null
[[ ! -e $fake/run/omamobile-caiman-gpu-ready.json ]] || fail "existing marker must block GPU load"
[[ -z $(loads) ]] || fail "existing marker must block all modprobe calls"
[[ $(cat "$fake/run/omamobile-caiman-display-card") == /dev/dri/card0 ]] || fail "marker block must still publish simpledrm display card"

# 2. --retry clears marker, sets allow_tx=1 for google-cm4 before gs_decon stage=2 fbdev=0, prefers gs-decon card1.
reset_gfx google-cm4
mkdir -p "$fake/var/lib/omamobile"
echo "2026-11-13 gpu" > "$fake/var/lib/omamobile/caiman-graphics-started"
out=$(PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start" --retry)
[[ ! -e $fake/var/lib/omamobile/caiman-graphics-started ]] || fail "--retry must clear marker on success"
[[ $(loads) == "panthor gs_dsim_cmd gs_decon" ]] || fail "unexpected load order: $(loads)"
grep -q '^gs_decon stage=2 fbdev=0 allow_tx=1$' "$tlog" || fail "gs_decon missing options or allow_tx=1: $(grep '^gs_decon' "$tlog")"
[[ -s $fake/run/omamobile-caiman-gpu-ready.json ]] || fail "GPU ready json must be created"
[[ $(cat "$fake/run/omamobile-caiman-display-card") == /dev/dri/card1 ]] || fail "gs-decon DRM card must override simpledrm"
[[ $out == *"up: GPU, display"* ]] || fail "missing up summary: $out"

# 3. Suffixed bootloader panel_name (google-cm4.<id>) is also allowed; other/empty panel names stay off.
reset_gfx google-cm4.12345678
PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start" >/dev/null
grep -q '^gs_decon stage=2 fbdev=0 allow_tx=1$' "$tlog" || fail "suffixed google-cm4 must set allow_tx=1"

reset_gfx google-other
PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start" >/dev/null
grep -q '^gs_decon stage=2 fbdev=0 allow_tx=0$' "$tlog" || fail "other panel must keep allow_tx=0"

reset_gfx ""
PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start" >/dev/null
grep -q '^gs_decon stage=2 fbdev=0 allow_tx=0$' "$tlog" || fail "unnamed panel must keep allow_tx=0"

# 4. Failed GPU still brings up display; failed display keeps GPU + simpledrm fallback and clears marker.
reset_gfx google-cm4
out=$(FAIL_MODULE=panthor PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start") && fail "failed GPU must exit non-zero"
[[ ! -e $fake/var/lib/omamobile/caiman-graphics-started ]] || fail "failed GPU must clear marker"
[[ ! -e $fake/run/omamobile-caiman-gpu-ready.json ]] || fail "failed GPU must not create ready json"
[[ $out == *"up: display"* && $(cat "$fake/run/omamobile-caiman-display-card") == /dev/dri/card1 ]] || fail "failed GPU must still bring up display"

reset_gfx google-cm4
out=$(FAIL_MODULE=gs_decon PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start") && fail "failed display must exit non-zero"
[[ ! -e $fake/var/lib/omamobile/caiman-graphics-started ]] || fail "failed display must clear marker"
[[ -s $fake/run/omamobile-caiman-gpu-ready.json && $(cat "$fake/run/omamobile-caiman-display-card") == /dev/dri/card0 ]] || fail "failed display must preserve GPU and simpledrm fallback"

# 5. Stage 6 peripherals load in order (Wi-Fi before Bluetooth); torch resets lit state; NFC requires DT clocks.
reset_gfx google-cm4
periph_dt_enable
out=$(PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start")
[[ $(loads) == "panthor gs_dsim_cmd gs_decon cs40l26_vibra leds_lm3644 max77779_battery phy_zuma_pcie pcie_gs201 brcmfmac hci_uart nxp_nci_i2c" ]] \
  || fail "unexpected full load order: $(loads)"
[[ $out == *"up: GPU, display, haptics, torch, gauge 87 %, Wi-Fi (wlp1s0), Bluetooth, NFC"* ]] \
  || fail "missing peripheral summary: $out"

reset_gfx google-cm4
periph_dt_enable
rm -f "$dt/usi@10c900c0/i2c@10c90000/nfc@8/clocks"
out=$(TORCH_INIT_BRIGHTNESS=64 PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start") && fail "lit torch must report skip/failure"
[[ $(cat "$fake/sys/class/leds/white:torch/brightness") == 0 ]] || fail "lit torch must be turned off"
[[ $out == *"the torch came up lit; turned off"* && $out == *"no NFC with its clock in this DTB; skipped"* ]] \
  || fail "unexpected torch/NFC guard output: $out"
[[ $(loads) != *nxp_nci_i2c* ]] || fail "NFC without clocks property must not load nxp_nci_i2c"

# 6. Missing DTB nodes skip cleanly.
reset_gfx google-cm4
mv "$fake/sys/bus/platform/devices/19470000.display-controller" "$tmp/decon"
out=$(PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start")
[[ $(loads) == panthor && $out == *"up: GPU"* ]] || fail "missing decon node must still load GPU: $out"
mv "$tmp/decon" "$fake/sys/bus/platform/devices/19470000.display-controller"

reset_gfx google-cm4
mv "$fake/sys/bus/platform/devices/1f000000.gpu" "$tmp/gpu"
mv "$fake/sys/bus/platform/devices/19470000.display-controller" "$tmp/decon"
out=$(PATH="$fbin:$PATH" OMAMOBILE_CAIMAN_ROOT="$fake" "$tmp/root/usr/bin/omamobile-caiman-graphics-start")
[[ -z $(loads) && $out == *"nothing to do"* ]] || fail "missing both nodes must do nothing: $out"
mv "$tmp/gpu" "$fake/sys/bus/platform/devices/1f000000.gpu"
mv "$tmp/decon" "$fake/sys/bus/platform/devices/19470000.display-controller"
pass "hang-safe graphics start honors marker, --retry, allow_tx, gs_decon, peripherals, and card discovery"

./test/aoc-start
./test/charge-limit

net=vendor/systemd/network/20-usb-gadget.network
! sed -n '/^\[Network\]/,/^\[/p' "$net" | grep -c '^Gateway=' >/dev/null || fail "usb0 sets no default route in [Network] (metric 0)"
metric=$(sed -n '/^\[Route\]/,/^\[/{s/^Metric=//p;}' "$net")
[[ ${metric:-0} -gt 700 ]] || fail "usb0's gateway goes after Wi-Fi (600) and mobile data (700)"
pass "USB is the last gateway"
