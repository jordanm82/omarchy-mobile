#!/bin/bash
# SPDX-License-Identifier: MIT
# Bring up the Pixel 9 Pro's GPU (panthor) and KMS display (gs_decon) at
# boot, hang-safe. Both drivers are blacklisted for autoload
# (modprobe.d/omamobile-caiman-guards.conf), so this script loads them in
# order after writing and syncing a marker. If either step fails and returns,
# the failure is logged and skipped so simpledrm (when present) still brings
# up the desktop on llvmpipe; only a hard kernel hang leaves the marker behind,
# causing the next boot to leave them unloaded until an owner runs:
#   omamobile-caiman-graphics-start [--retry]
#
# gs_dsim_cmd.allow_tx (panel brightness, sleep and 120 Hz) is allowed only
# when the bootloader names google-cm4 (or google-cm4.<id>) on the command
# line, before gs_decon loads.
# OMAMOBILE_CAIMAN_ROOT: a scratch root for package tests (fake /sys, /dev).
set -uo pipefail

root=${OMAMOBILE_CAIMAN_ROOT:-}
if [[ -n $root ]]; then
  [[ $root == /* && $root != / && -d $root ]] || exit 2
  root=$(readlink -f "$root")
fi

state=$root/var/lib/omamobile
marker=$state/caiman-graphics-started
cmdline=$root/proc/cmdline
gpu=$root/sys/bus/platform/devices/1f000000.gpu
decon=$root/sys/bus/platform/devices/19470000.display-controller
allow_tx=$root/sys/module/gs_dsim_cmd/parameters/allow_tx

log() { echo "omamobile-caiman-graphics: $*"; }
loaded() { [[ -d $root/sys/module/$1 ]]; }

# Wait for a device to bind to a driver: device dir, driver name, quarter seconds.
bound() {
  local i
  for ((i = 0; i < $3; i++)); do
    [[ $(readlink -f "$1/driver" 2>/dev/null) == */$2 ]] && return 0
    sleep 0.25
  done
  return 1
}

panel_name() {
  local word
  for word in $(cat "$cmdline" 2>/dev/null); do
    [[ $word == exynos_drm.panel_name=* ]] && { echo "${word#*=}"; return 0; }
  done
  echo ""
}

resolve_display_card() {
  local by_path card
  for by_path in \
    "$root/dev/dri/by-path/platform-19470000.display-controller-card" \
    "$root/dev/dri/by-path/platform-chosen:framebuffer-card"; do
    card=$(readlink -f "$by_path" 2>/dev/null || true)
    if [[ -n $card && -e $card ]]; then
      printf '%s\n' "${card#"$root"}" > "$root/run/omamobile-caiman-display-card"
      return 0
    fi
  done
  return 1
}

case ${1:-} in
  '') ;;
  --retry) rm -f "$marker" ;;
  *) log "usage: omamobile-caiman-graphics-start [--retry]"; exit 2 ;;
esac

mkdir -p "$state" "$root/run"

if [[ -e $marker ]]; then
  log "the last start ($(cat "$marker" 2>/dev/null)) never finished; GPU and display stay off this boot."
  log "after checking the previous boot's log, retry with: omamobile-caiman-graphics-start --retry"
  resolve_display_card || true
  exit 0
fi

# Publish the existing display card (simpledrm) first so desktop launch still
# has AQ_DRM_DEVICES if the GPU or KMS display step is absent or skipped.
resolve_display_card || true

if [[ ! -e $gpu && ! -e $decon ]]; then
  log "no GPU and no display controller in this DTB; nothing to do"
  exit 0
fi

if [[ ${1:-} != --retry ]] && { loaded panthor || loaded gs_decon; }; then
  log "already started this boot"
  exit 0
fi

phase() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" > "$marker"; sync -f "$marker" 2>/dev/null || sync; }
finish() { rm -f "$marker"; sync -f "$state" 2>/dev/null || sync; }

up=
failed=
skip() { log "$2; skipped"; failed+="${failed:+, }$1"; }

if [[ -e $gpu ]]; then
  phase gpu
  if ! modprobe panthor; then
    skip GPU "panthor failed (no mali_csffw.bin yet? see dmesg)"
  elif ! bound "$gpu" panthor 60; then
    skip GPU "the GPU did not bind to panthor (see dmesg)"
  else
    printf '{"gpu": "panthor", "by": "omamobile-caiman-graphics-start"}\n' > "$root/run/omamobile-caiman-gpu-ready.json"
    up+="GPU"
  fi
else
  log "no GPU in this DTB; skipped"
fi

if [[ -e $decon ]]; then
  phase display
  modprobe gs_dsim_cmd 2>/dev/null || true
  panel=$(panel_name)
  if [[ $panel == google-cm4 || $panel == google-cm4.* ]]; then
    if echo 1 > "$allow_tx" 2>/dev/null; then
      log "panel $panel: DSI commands allowed (gs_dsim_cmd.allow_tx=1)"
    else
      log "panel $panel: could not write $allow_tx; the display stays read-only at 60 Hz"
    fi
  else
    log "panel ${panel:-unnamed}: DSI commands stay off; the display stays read-only at 60 Hz"
  fi
  if ! modprobe gs_decon stage=2 fbdev=0; then
    skip display "gs_decon failed (see dmesg)"
  elif ! bound "$decon" gs-decon 60; then
    skip display "the display controller did not bind to gs-decon (see dmesg)"
  else
    up+="${up:+, }display"
  fi
else
  log "no display controller in this DTB; skipped"
fi

# Re-resolve after panthor and gs_decon in case DRM card numbers shifted.
resolve_display_card || true

finish
log "up: ${up:-nothing}"
if [[ -n $failed ]]; then
  log "failed: $failed (marker cleared; --retry tries again)"
  exit 1
fi
exit 0
