#!/bin/bash
# SPDX-License-Identifier: MIT
# Bring up the Pixel 9 Pro's GPU, display, haptics, torch, battery gauge,
# Wi-Fi, Bluetooth controller and NFC at boot, hang-safe. All ten drivers are
# blacklisted for autoload (modprobe.d/omamobile-caiman-guards.conf), so this
# script loads them in order after writing and syncing a marker. If a step
# fails and returns, the failure is logged and skipped so simpledrm (when
# present) still brings up the desktop on llvmpipe and remaining peripherals
# still start; only a hard kernel hang leaves the marker behind, causing the
# next boot to leave them unloaded until an owner runs:
#   omamobile-caiman-graphics-start [--retry]
#
# gs_dsim_cmd.allow_tx (panel brightness, sleep and 120 Hz) is allowed only
# when the bootloader names google-cm4 (or google-cm4.<id>) on the command
# line, before gs_decon loads.
# OMAMOBILE_CAIMAN_ROOT: a scratch root for package tests (fake /sys, /dev).
set -uo pipefail

root=${OMAMOBILE_CAIMAN_ROOT:-}
if [[ -n $root ]]; then
  [[ $root == /* && $root != / && -d $root ]] || exit 2
  root=$(readlink -f "$root")
fi

state=$root/var/lib/omamobile
marker=$state/caiman-graphics-started
dt=$root/proc/device-tree
cmdline=$root/proc/cmdline
gpu=$root/sys/bus/platform/devices/1f000000.gpu
decon=$root/sys/bus/platform/devices/19470000.display-controller
allow_tx=$root/sys/module/gs_dsim_cmd/parameters/allow_tx
torch=$root/sys/class/leds/white:torch
gauge=$root/sys/class/power_supply/max77779-battery
haptics_node=$dt/soc/usi@10c900c0/i2c@10c90000/haptic-driver@43
torch_node=$dt/soc/usi@108b00c0/i2c@108b0000/led-controller@63
gauge_node=$dt/soc/usi@108d00c0/i2c@108d0000/fuel-gauge@36
bluetooth_node=$dt/soc/usi@155d00c0/serial@155d0000/bluetooth
nfc_node=$dt/soc/usi@10c900c0/i2c@10c90000/nfc@8
nfc=$root/sys/class/nfc/nfc0
wifi_pcie=$root/sys/bus/platform/devices/13120000.pcie
wifi_pool=$dt/reserved-memory/wifi-dma-pool
wifi_fw=$root/usr/lib/firmware/updates/brcm/brcmfmac4390b1-pcie.google,zumapro-caiman.bin

log() { echo "omamobile-caiman-graphics: $*"; }
loaded() { [[ -d $root/sys/module/$1 ]]; }
# A device-tree node is enabled when it exists and has no status or "okay".
enabled() {
  [[ -d $1 ]] || return 1
  [[ -e $1/status ]] || return 0
  case $(tr -d '\0' < "$1/status") in okay|ok) return 0 ;; *) return 1 ;; esac
}

# Wait for a device to bind to a driver: device dir, driver name, quarter seconds.
bound() {
  local i
  for ((i = 0; i < $3; i++)); do
    [[ $(readlink -f "$1/driver" 2>/dev/null) == */$2 ]] && return 0
    sleep 0.25
  done
  return 1
}

panel_name() {
  local word
  for word in $(cat "$cmdline" 2>/dev/null); do
    [[ $word == exynos_drm.panel_name=* ]] && { echo "${word#*=}"; return 0; }
  done
  echo ""
}

resolve_display_card() {
  local by_path card
  for by_path in \
    "$root/dev/dri/by-path/platform-19470000.display-controller-card" \
    "$root/dev/dri/by-path/platform-chosen:framebuffer-card"; do
    card=$(readlink -f "$by_path" 2>/dev/null || true)
    if [[ -n $card && -e $card ]]; then
      printf '%s\n' "${card#"$root"}" > "$root/run/omamobile-caiman-display-card"
      return 0
    fi
  done
  return 1
}

case ${1:-} in
  '') ;;
  --retry) rm -f "$marker" ;;
  *) log "usage: omamobile-caiman-graphics-start [--retry]"; exit 2 ;;
esac

mkdir -p "$state" "$root/run"

if [[ -e $marker ]]; then
  log "the last start ($(cat "$marker" 2>/dev/null)) never finished; GPU, display, haptics, torch, gauge, Wi-Fi, Bluetooth and NFC stay off this boot."
  log "after checking the previous boot's log, retry with: omamobile-caiman-graphics-start --retry"
  resolve_display_card || true
  exit 0
fi

# Publish the existing display card (simpledrm) first so desktop launch still
# has AQ_DRM_DEVICES if the GPU or KMS display step is absent or skipped.
resolve_display_card || true

if [[ ! -e $gpu && ! -e $decon ]]; then
  log "no GPU and no display controller in this DTB; nothing to do"
  exit 0
fi

if [[ ${1:-} != --retry ]] && { loaded panthor || loaded gs_decon; }; then
  log "already started this boot"
  exit 0
fi

phase() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" > "$marker"; sync -f "$marker" 2>/dev/null || sync; }
finish() { rm -f "$marker"; sync -f "$state" 2>/dev/null || sync; }

up=
failed=
skip() { log "$2; skipped"; failed+="${failed:+, }$1"; }

if [[ -e $gpu ]]; then
  phase gpu
  if ! modprobe panthor; then
    skip GPU "panthor failed (no mali_csffw.bin yet? see dmesg)"
  elif ! bound "$gpu" panthor 60; then
    skip GPU "the GPU did not bind to panthor (see dmesg)"
  else
    printf '{"gpu": "panthor", "by": "omamobile-caiman-graphics-start"}\n' > "$root/run/omamobile-caiman-gpu-ready.json"
    up+="GPU"
  fi
else
  log "no GPU in this DTB; skipped"
fi

if [[ -e $decon ]]; then
  phase display
  modprobe gs_dsim_cmd 2>/dev/null || true
  panel=$(panel_name)
  if [[ $panel == google-cm4 || $panel == google-cm4.* ]]; then
    if echo 1 > "$allow_tx" 2>/dev/null; then
      log "panel $panel: DSI commands allowed (gs_dsim_cmd.allow_tx=1)"
    else
      log "panel $panel: could not write $allow_tx; the display stays read-only at 60 Hz"
    fi
  else
    log "panel ${panel:-unnamed}: DSI commands stay off; the display stays read-only at 60 Hz"
  fi
  if ! modprobe gs_decon stage=2 fbdev=0; then
    skip display "gs_decon failed (see dmesg)"
  elif ! bound "$decon" gs-decon 60; then
    skip display "the display controller did not bind to gs-decon (see dmesg)"
  else
    up+="${up:+, }display"
  fi
else
  log "no display controller in this DTB; skipped"
fi

# Re-resolve after panthor and gs_decon in case DRM card numbers shifted.
resolve_display_card || true

if enabled "$haptics_node"; then
  phase haptics
  if modprobe cs40l26_vibra; then up+="${up:+, }haptics"; else skip haptics "cs40l26_vibra failed (see dmesg)"; fi
else
  log "no haptics in this DTB; skipped"
fi

if enabled "$torch_node"; then
  phase torch
  if ! modprobe leds_lm3644; then
    skip torch "leds_lm3644 failed (see dmesg)"
  else
    for _ in $(seq 40); do [[ -e $torch/brightness ]] && break; sleep 0.25; done
    if [[ ! -e $torch/brightness ]]; then
      log "no white:torch LED after the driver loaded (see dmesg)"
    elif [[ $(cat "$torch/brightness") != 0 ]]; then
      # It must start off: turn it off here and say so.
      echo 0 > "$torch/brightness" 2>/dev/null
      skip torch "the torch came up lit; turned off (brightness now $(cat "$torch/brightness" 2>/dev/null))"
    else
      up+="${up:+, }torch"
    fi
  fi
else
  log "no torch in this DTB; skipped"
fi

if enabled "$gauge_node"; then
  phase gauge
  if ! modprobe max77779_battery; then
    skip gauge "max77779_battery failed (see dmesg)"
  else
    for _ in $(seq 40); do [[ -e $gauge/capacity ]] && break; sleep 0.25; done
    if [[ -e $gauge/capacity ]]; then
      up+="${up:+, }gauge $(cat "$gauge/capacity") %"
    else
      log "no max77779-battery supply after the driver loaded (see dmesg)"
    fi
  fi
else
  log "no fuel gauge in this DTB; skipped"
fi

# Wi-Fi (BCM4390/5 on PCIe channel 1) MUST load and boot fw_bcmdhd before
# hci_uart runs btbcm_patchram on BCM4390B1: the Bluetooth core shares the
# WLAN radio and times out HCI 0xfc18 (-110) if loaded ahead of brcmfmac.
if [[ -e $wifi_pcie && -e $wifi_pool && -e $wifi_fw ]]; then
  phase wifi
  failed_host=
  for m in phy_zuma_pcie pcie_gs201; do modprobe "$m" || { failed_host=$m; break; }; done
  if [[ -n $failed_host ]]; then
    skip Wi-Fi "$failed_host failed (see dmesg)"
  else
    for _ in $(seq 20); do [[ -e $root/sys/bus/pci/devices/0000:01:00.0 ]] && break; sleep 0.25; done
    if [[ ! -e $root/sys/bus/pci/devices/0000:01:00.0 ]]; then
      skip Wi-Fi "no Wi-Fi endpoint on the PCIe link (see dmesg)"
    elif ! modprobe brcmfmac; then
      skip Wi-Fi "brcmfmac failed (see dmesg)"
    else
      wl=
      for _ in $(seq 60); do
        for d in "$root"/sys/class/net/wl*; do [[ -e $d ]] && wl=${d##*/} && break; done
        [[ -n $wl ]] && break; sleep 0.5
      done
      if [[ -n $wl ]]; then up+="${up:+, }Wi-Fi ($wl)"; else skip Wi-Fi "brcmfmac brought up no interface (see dmesg)"; fi
    fi
  fi
else
  log "no Wi-Fi host, DMA pool or BCM4390B1 firmware in this boot; skipped"
fi

# The address and the power-on are omamobile-bt-addr@'s, started by udev.
if enabled "$bluetooth_node"; then
  phase bluetooth
  if modprobe hci_uart; then up+="${up:+, }Bluetooth"; else skip Bluetooth "hci_uart failed (see dmesg)"; fi
else
  log "no Bluetooth in this DTB; skipped"
fi

# NFC: nxp-nci on the haptics' bus, with the PMU's NFC clock pad as its
# reference clock (clk-exynos-clkout); without the clock the ST54L doesn't
# answer on I2C, so the node names it and the driver turns it on.
if enabled "$nfc_node" && [[ -e $nfc_node/clocks ]]; then
  phase nfc
  if ! modprobe nxp_nci_i2c; then
    skip NFC "nxp_nci_i2c failed (see dmesg)"
  else
    for _ in $(seq 20); do [[ -e $nfc ]] && break; sleep 0.25; done
    if [[ -e $nfc ]]; then up+="${up:+, }NFC"; else skip NFC "no nfc0 after the driver loaded (see dmesg)"; fi
  fi
else
  log "no NFC with its clock in this DTB; skipped"
fi

finish
log "up: ${up:-nothing}"
if [[ -n $failed ]]; then
  log "failed: $failed (marker cleared; --retry tries again)"
  exit 1
fi
exit 0
