# Bring up the Pixel 9 Pro GPU, display, haptics, torch, gauge, Wi-Fi, Bluetooth
# and NFC at boot, enabled by the vendor multi-user.target.wants link. The
# drivers are blacklisted for autoload (modprobe.d/omamobile-caiman-guards.conf),
# so this hang-safe script is the only thing that loads them; if a load
# hangs, the next boot leaves them off (see the script).
[Unit]
Description=Bring up the Pixel 9 Pro GPU, display, haptics, torch, gauge, Wi-Fi, Bluetooth and NFC (hang-safe)
After=local-fs.target systemd-modules-load.service
Before=display-manager.service
ConditionPathExists=|/sys/bus/platform/devices/1f000000.gpu
ConditionPathExists=|/sys/bus/platform/devices/19470000.display-controller
ConditionPathExists=|/sys/bus/platform/devices/chosen:framebuffer

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-caiman-graphics-start
RemainAfterExit=yes
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
