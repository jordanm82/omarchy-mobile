#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-device-caiman into DESTDIR. Nothing is enabled that would
# mark a slot successful or start the radio or a camera.
#   ./install DESTDIR [BUILDDIR]
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR [BUILDDIR]}
build=${2:-build}
[[ $destination == /* && $destination != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
stage() {
  install -d "$(dirname -- "$3")"
  install -m"$1" "$2" "$3"
}
for file in bin/*; do stage 755 "$file" "$destination/usr/bin/${file##*/}"; done
stage 755 "$build/reboot-to" "$destination/usr/bin/reboot-to"
while IFS= read -r -d '' file; do
  mode=644
  [[ $file == vendor/systemd/system-sleep/* ]] && mode=755
  stage "$mode" "$file" "$destination/usr/lib/${file#vendor/}"
done < <(find vendor -type f -print0)
while IFS= read -r -d '' file; do
  install -d "$destination/usr/lib/$(dirname "${file#vendor/}")"
  ln -sfn "$(readlink "$file")" "$destination/usr/lib/${file#vendor/}"
done < <(find vendor -type l -print0)
stage 644 uwsm/env.d/omamobile-caiman-graphics \
  "$destination/usr/share/uwsm/env.d/omamobile-caiman-graphics"
stage 644 device.conf \
  "$destination/usr/share/omamobile/device.conf"
stage 644 etc/omamobile-mirrorlist \
  "$destination/etc/pacman.d/omamobile-mirrorlist"
stage 644 LICENSE "$destination/usr/share/licenses/omamobile-device-caiman/LICENSE"
stage 644 version "$destination/usr/share/omamobile/device-caiman/version"
