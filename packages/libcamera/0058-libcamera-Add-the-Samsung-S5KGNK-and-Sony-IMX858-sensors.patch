index eaef79f..9d78f3e 100644
--- a/src/ipa/simple/data/meson.build
+++ b/src/ipa/simple/data/meson.build
@@ -2,10 +2,12 @@
 
 conf_files = files([
     'imx386.yaml',
+    'imx858.yaml',
     's5k3j1.yaml',
     's5kgm5.yaml',
     's5kgn1.yaml',
     's5kgn8.yaml',
+    's5kgnk.yaml',
     'uncalibrated.yaml',
 ])
 
